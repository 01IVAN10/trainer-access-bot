# Шаблон налаштувань. Скопіюй у .env і заповни:  cp .env.example .env
# Цей файл можна комітити — тут немає справжніх значень.
#
# На Mac (.env) — усе для DEV: dev-бот, канал [DEV], група [DEV].
# На Railway (Variables) — усе для PROD. Код однаковий.

# Токен бота від @BotFather
BOT_TOKEN=

# ID закритого каналу (-100…). Дізнатися: python -m tools.find_chats
CHANNEL_ID=

# ID адмін-групи (-100…). Дізнатися: python -m tools.find_chats
ADMIN_CHAT_ID=

# Токен monobank acquiring. Тестовий: api.monobank.ua → «Create test token»
MONO_TOKEN=

# Файл бази даних (необов'язково; на Railway: /data/bot.db)
# DB_PATH=storage/bot.db
