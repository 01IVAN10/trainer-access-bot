# Шаблон налаштувань. Скопіюй у .env і заповни:  cp .env.example .env
# Цей файл можна комітити — тут немає справжніх значень.
#
# На Mac (.env) — усе для DEV: dev-бот, канал [DEV], група [DEV].
# На Railway (Variables) — усе для PROD. Код однаковий.

# Токен бота від @BotFather
BOT_TOKEN=

# ID закритого каналу (-100…). Дізнатися: python -m tools.find_chats
CHANNEL_ID=

# ID адмін-групи (-100…). Дізнатися: python -m tools.find_chats
ADMIN_CHAT_ID=

# Токен monobank acquiring. Тестовий: api.monobank.ua → «Create test token»
MONO_TOKEN=

# Контакт підтримки з оплат (/paysupport, /help). Telegram вимагає, щоб бот з оплатами
# мав зрозумілий спосіб зв'язатися щодо платежів. Наприклад: @username або +380…
SUPPORT_CONTACT=

# Демо-режим для портфоліо: 1 — показувати демо-тариф і позначки «тестова оплата».
# У боті для реального клієнта — 0 (або не задавати).
DEMO_MODE=1

# Часовий пояс для дат у повідомленнях (необов'язково)
# TIMEZONE=Europe/Kyiv

# Файл бази даних (необов'язково; на Railway: /data/bot.db)
# DB_PATH=storage/bot.db

# Публічна https-адреса бота для webhook від mono (необов'язково).
# Порожньо — оплату підтверджують кнопка «Перевірити» і фонова звірка (зручно на Mac).
# Локально з тунелем: https://xxxx.trycloudflare.com ; на Railway — домен сервісу.
# WEBHOOK_BASE_URL=

# Порт HTTP-сервера бота (необов'язково; Railway задає PORT сам)
# PORT=8080
