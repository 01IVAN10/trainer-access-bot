# Секрети — ніколи не в Git
.env
# .env.prod тощо (крок 9). Коментар — лише окремим рядком: «#» у кінці рядка git вважає частиною шаблону
.env.*
# шаблон без значень — можна
!.env.example

# Віртуальне середовище
.venv/

# Python-сміття
__pycache__/
*.pyc
.pytest_cache/

# Локальна база даних
storage/
*.db
*.db-journal

# macOS
.DS_Store
